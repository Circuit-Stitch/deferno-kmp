<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Export options for `xcodebuild -exportArchive`, used by .github/workflows/testflight.yml.

  destination = export          → write a signed Deferno.ipa to disk. The workflow then verifies its
                                  signature and uploads it with `xcrun altool`. Exporting and uploading
                                  used to be one step (destination = upload), which left no artifact to
                                  check and no way to fail the run on a bad signature.
  method      = app-store-connect → the TestFlight / App Store distribution pipeline (Xcode 16+ name;
                                  the pre-16 alias was `app-store`).
  signingStyle = automatic + the workflow's `-allowProvisioningUpdates` + the App Store Connect API key
                                  → Xcode creates/reuses the Apple Distribution cert and the App Store
                                  provisioning profile in the cloud. No certs or .mobileprovision in git.
  teamID      = GDV76FJJZ5       → Kyle Falconer's paid Apple Developer Program team (the only one with
                                  an Apple Distribution authority for com.circuitstitch.deferno).
  manageAppVersionAndBuildNumber = false → keep the CFBundleVersion the workflow stamps from the run
                                  number (CURRENT_PROJECT_VERSION); don't let Xcode auto-bump it.
  uploadSymbols = true          → ship dSYMs so TestFlight crash reports are symbolicated.

  There is deliberately NO `testFlightInternalTestingOnly` key. Apple's default is NO, which is what a
  release build needs. Setting it to YES marks the uploaded build so it "cannot be distributed via
  external TestFlight or the App Store" — permanently, for that build. The flag travels with the upload
  and cannot be cleared in App Store Connect afterwards; the only fix is a fresh build number. This
  file set it to YES until 2026-08-21, which is why every build so far reached internal testers and
  then stopped. See app/iosApp/README.md.
-->
<plist version="1.0">
<dict>
    <key>destination</key>
    <string>export</string>
    <key>method</key>
    <string>app-store-connect</string>
    <key>teamID</key>
    <string>GDV76FJJZ5</string>
    <key>signingStyle</key>
    <string>automatic</string>
    <key>manageAppVersionAndBuildNumber</key>
    <false/>
    <key>uploadSymbols</key>
    <true/>
</dict>
</plist>
