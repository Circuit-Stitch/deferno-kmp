-- One ordered slot of a daily plan (ADR-0001, #21, #385). The daily plan (`GET /items/plan`) is an
-- ordered, date-scoped list referencing Items of ANY kind, so a plan row is keyed by
-- `(plan_date, position)` and points at an `item_id` that lives in `taskEntity`, `habitEntity`,
-- `choreEntity` or `eventEntity` — whichever `kind` names. Reconciled as a full snapshot per day
-- (#22): delete the day's entries, re-insert the fresh ordered set, in one transaction.
-- `plan_date` is an ISO date string (e.g. `2026-06-06`).
--
-- `kind` is the ItemKind enum NAME, written straight off the `/items/plan` row's tag — the same
-- idiom `calendarItemEntity.kind` uses, and NULLABLE for the same reason: the value's provenance is
-- a server token, and a token this client does not recognise must be preserved as "unknown" rather
-- than coerced. Defaulting an unknown kind to Task is exactly the defect #385 exists to fix, so the
-- read resolves a NULL-kind row as unresolvable instead of mis-resolving it into `taskEntity`.
--
-- `tz` is RECORDED, not KEYED (#385). The server has exactly one plan per day
-- (`user:{id}:daily_plan:{date}`, no zone) — the zone is a request parameter resolving *which* day,
-- persisted account-side as of #392. Keying on it locally modelled a per-zone plan the server cannot
-- represent, and made a zone flip blank the cached day. The column stays because which zone a day was
-- captured under is worth holding for later timezone work; it is just not part of the day's identity.
-- `(plan_date, position)` as PRIMARY KEY supplies the unique index the per-day `ORDER BY position`
-- read walks, so no separate index is declared.
CREATE TABLE dailyPlanEntry (
    plan_date TEXT NOT NULL,
    position  INTEGER NOT NULL,
    item_id   TEXT NOT NULL,
    kind      TEXT,
    tz        TEXT NOT NULL,
    PRIMARY KEY (plan_date, position)
);

selectPlan:
SELECT * FROM dailyPlanEntry WHERE plan_date = ? ORDER BY position;

insertEntry:
INSERT OR REPLACE INTO dailyPlanEntry(plan_date, position, item_id, kind, tz) VALUES (?, ?, ?, ?, ?);

deletePlan:
DELETE FROM dailyPlanEntry WHERE plan_date = ?;

-- Re-point every plan slot referencing an item id (issue #185, id-heal): when an offline-created
-- Item's client id is replaced by a different server canonical id, plan rows that already pointed at
-- it follow. Kind-neutral since #385 — a Habit/Chore/Event can be planned too, so this is no longer
-- reachable only from the Task heal path. `item_id` is not unique (an item can be planned on many
-- days), so this updates all matching slots.
rekeyItem:
UPDATE dailyPlanEntry SET item_id = ? WHERE item_id = ?;

deleteAll:
DELETE FROM dailyPlanEntry;
