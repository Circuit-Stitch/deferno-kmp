-- The local source-of-truth Habit table (ADR-0001, #71). A recurring definition: columns mirror the
-- DOMAIN Habit (ADR-0011, schema from domain not wire). Like taskEntity, every column is a SQL
-- primitive (TEXT/INTEGER/REAL) so the generated DB needs no adapters; the row<->domain conversion
-- (the DefinitionState enum, the Recurrence object, instants, the labels list) is done in Kotlin in
-- core:data (HabitEntityMapping.kt). `definition_state` is the "light switch" — NOT a working_state.
-- `recurrence_type`/`recurrence_days` hold the flattened domain Recurrence.
CREATE TABLE habitEntity (
    id               TEXT NOT NULL PRIMARY KEY,
    org_slug         TEXT NOT NULL,
    owner_org_id     TEXT,
    ref              TEXT,
    sequence         INTEGER,
    title            TEXT NOT NULL,
    definition_state TEXT NOT NULL,
    recurrence_type  TEXT,
    recurrence_days  TEXT NOT NULL DEFAULT '',
    labels           TEXT NOT NULL DEFAULT '',
    parent_id        TEXT,
    complete_by      TEXT,
    pinned           INTEGER NOT NULL DEFAULT 0,
    date_created     TEXT NOT NULL,
    deleted_at       TEXT,
    hydration_state  TEXT NOT NULL,
    description      TEXT,
    series_id        TEXT,
    -- Appended for migration 2->3 (#348) — ADD COLUMN appends, so it lives at the table's end.
    deadline_time_of_day TEXT,
    -- Appended for migration 9->10 (#290) — server-derived dependency flags (a recurring row inherits
    -- `blocked` from a blocked ancestor). Nullable so ADD COLUMN leaves pre-migration rows NULL.
    blocked    INTEGER,
    is_blocker INTEGER,
    -- Appended for migration 17->18 (#375) — the soft target date + the urgency bucket, both riding
    -- every read and carried on all four kinds (peers of complete_by/pinned). `priority` stores the
    -- Priority enum NAME, like definition_state. Nullable so ADD COLUMN leaves pre-migration rows NULL
    -- (decoded as "no target" / Priority.Normal until the next refresh repopulates).
    target_date TEXT,
    priority    TEXT,
    -- Appended for migration 18->19 (#382) — the rest of the recurrence rule. `recurrence_type` +
    -- `recurrence_days` only ever held a frequency and a weekday list, so every other cadence parameter
    -- and the whole `end` bound were destroyed by a cache round-trip: an every-30-days and an
    -- every-29-days chore were literally the same row. Twelve FLAT nullable primitives, deliberately
    -- NOT one recurrence_json blob — a blob would breach this table's no-adapters invariant (see the
    -- header) and make "find every item recurring monthly" impossible without a full-table Kotlin scan.
    -- Which columns are meaningful is decided by `recurrence_type`; all are NULL for a cadence that does
    -- not use them, and NULL on every pre-migration row until the next refresh repopulates it.
    --
    -- `recurrence_interval` is the cycle multiplier for BOTH wire spellings (`every_n_days.n` and
    -- `monthly`/`yearly`'s `interval`) — one domain concept whose unit the frequency supplies.
    -- The `anchor_*` trio is the monthly `on` anchor and is kept SEPARATE from the yearly
    -- `recurrence_month`/`recurrence_day` pair even though monthly and yearly are mutually exclusive:
    -- sharing a "day" column would make the row decode ambiguous and break the round-trip.
    -- `recurrence_end_*` is the bound; a NULL `recurrence_end_type` reads as the Never bound, matching
    -- the wire, where an absent `end` key IS never. `recurrence_raw_type` holds the wire token of a
    -- cadence this client version cannot model, so it survives instead of becoming the string "Unknown".
    -- The `*_type` columns store the DOMAIN sealed-subtype name, like definition_state/priority.
    recurrence_interval       INTEGER,
    recurrence_anchor_type    TEXT,
    recurrence_anchor_day     INTEGER,
    recurrence_anchor_nth     INTEGER,
    recurrence_anchor_weekday TEXT,
    recurrence_month          INTEGER,
    recurrence_day            INTEGER,
    recurrence_rrule          TEXT,
    recurrence_end_type       TEXT,
    recurrence_end_date       TEXT,
    recurrence_end_count      INTEGER,
    recurrence_raw_type       TEXT
);

CREATE INDEX habitEntity_owner_org_id ON habitEntity(owner_org_id);
CREATE INDEX habitEntity_deleted_at ON habitEntity(deleted_at);

-- Live (non-tombstoned) rows — the UI-facing list (ADR-0001 observe-via-Flow).
selectAllActive:
SELECT * FROM habitEntity WHERE deleted_at IS NULL ORDER BY sequence;

selectById:
SELECT * FROM habitEntity WHERE id = ?;

-- Just the ids — the /items reconcile diffs these against a fresh snapshot to purge absent rows (#226).
selectAllIds:
SELECT id FROM habitEntity;

insertOrReplace:
INSERT OR REPLACE INTO habitEntity(
    id, org_slug, owner_org_id, ref, sequence, title, definition_state, recurrence_type,
    recurrence_days, labels, parent_id, complete_by, deadline_time_of_day, pinned, date_created,
    deleted_at, hydration_state, description, series_id, blocked, is_blocker, target_date, priority,
    recurrence_interval, recurrence_anchor_type, recurrence_anchor_day, recurrence_anchor_nth,
    recurrence_anchor_weekday, recurrence_month, recurrence_day, recurrence_rrule,
    recurrence_end_type, recurrence_end_date, recurrence_end_count, recurrence_raw_type
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,
          ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM habitEntity WHERE id = ?;
