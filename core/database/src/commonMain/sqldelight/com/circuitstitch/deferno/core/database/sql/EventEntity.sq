-- The local source-of-truth Event table (ADR-0001, #71). Mirrors habitEntity (a recurring definition
-- governed by definition_state) and adds the fixed-window fields: `complete_by` is the start,
-- `end_time` the end, `all_day` the flag. Adapter-free primitives; conversion in EventEntityMapping.kt.
CREATE TABLE eventEntity (
    id               TEXT NOT NULL PRIMARY KEY,
    org_slug         TEXT NOT NULL,
    owner_org_id     TEXT,
    ref              TEXT,
    sequence         INTEGER,
    title            TEXT NOT NULL,
    definition_state TEXT NOT NULL,
    recurrence_type  TEXT,
    recurrence_days  TEXT NOT NULL DEFAULT '',
    all_day          INTEGER NOT NULL DEFAULT 0,
    complete_by      TEXT,
    end_time         TEXT,
    labels           TEXT NOT NULL DEFAULT '',
    parent_id        TEXT,
    pinned           INTEGER NOT NULL DEFAULT 0,
    date_created     TEXT NOT NULL,
    deleted_at       TEXT,
    hydration_state  TEXT NOT NULL,
    description      TEXT,
    series_id        TEXT,
    -- Appended for migration 2->3 (#348) — ADD COLUMN appends, so these live at the table's end.
    start_time_of_day TEXT,
    end_time_of_day  TEXT,
    -- Appended for migration 9->10 (#290) — server-derived dependency flags (a recurring row inherits
    -- `blocked` from a blocked ancestor). Nullable so ADD COLUMN leaves pre-migration rows NULL.
    blocked    INTEGER,
    is_blocker INTEGER,
    -- Appended for migration 17->18 (#375) — the soft target date + the urgency bucket, both riding
    -- every read and carried on all four kinds (peers of complete_by/pinned). `priority` stores the
    -- Priority enum NAME, like definition_state. Nullable so ADD COLUMN leaves pre-migration rows NULL
    -- (decoded as "no target" / Priority.Normal until the next refresh repopulates).
    target_date TEXT,
    priority    TEXT,
    -- Appended for migration 18->19 (#382) — the rest of the recurrence rule; see HabitEntity.sq for the
    -- full rationale (flat primitives not a JSON blob; one `recurrence_interval` for both wire spellings
    -- of the cycle; the anchor trio kept separate from the yearly month/day; NULL end_type = the Never
    -- bound; raw_type preserves an unmodellable cadence). Distinct from this table's own
    -- `complete_by`/`end_time`, which are the ONE occurrence's fixed window, not the series' bound.
    recurrence_interval       INTEGER,
    recurrence_anchor_type    TEXT,
    recurrence_anchor_day     INTEGER,
    recurrence_anchor_nth     INTEGER,
    recurrence_anchor_weekday TEXT,
    recurrence_month          INTEGER,
    recurrence_day            INTEGER,
    recurrence_rrule          TEXT,
    recurrence_end_type       TEXT,
    recurrence_end_date       TEXT,
    recurrence_end_count      INTEGER,
    recurrence_raw_type       TEXT
);

CREATE INDEX eventEntity_owner_org_id ON eventEntity(owner_org_id);
CREATE INDEX eventEntity_deleted_at ON eventEntity(deleted_at);

selectAllActive:
SELECT * FROM eventEntity WHERE deleted_at IS NULL ORDER BY sequence;

selectById:
SELECT * FROM eventEntity WHERE id = ?;

-- Just the ids — the /items reconcile diffs these against a fresh snapshot to purge absent rows (#226).
selectAllIds:
SELECT id FROM eventEntity;

-- Just the "light switch" — the kind-neutral definition-state read (ADR-0053 decision 4, #390); see
-- HabitEntity.sq for the full rationale, including why the query name is kind-qualified.
selectEventDefinitionStates:
SELECT id, definition_state FROM eventEntity WHERE deleted_at IS NULL;

selectEventDefinitionStateById:
SELECT definition_state FROM eventEntity WHERE id = ? AND deleted_at IS NULL;

-- Binds the whole row as one parameter, so the generated signature is `insertOrReplace(EventEntity)` and
-- adding a column never touches the Kotlin call site.
insertOrReplace:
INSERT OR REPLACE INTO eventEntity VALUES ?;

deleteById:
DELETE FROM eventEntity WHERE id = ?;
